	)
	(text "以下の Panel CONNECTOR は、Baseからコピペ。\nERCの警告「別パネルのラベルがどこにも接続されていない」は、無視してOK。\n\n！！！他の警告（ラベルかぶりとか）は、しっかりチェックせよ！！！"
		(exclude_from_sim no)
		(at 16.51 189.865 0)
		(effects
			(font
				(size 5.08 5.08)
				(thickness 0.508)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "51809189-fed9-47c4-ba4a-a3e1d9ea690c")
	)
